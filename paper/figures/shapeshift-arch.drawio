        <mxCell id="kS1Jh0xNyDCQ81UR72km-270" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;sort &lt;i style=&quot;&quot;&gt;R&lt;/i&gt; by&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;(&lt;i style=&quot;&quot;&gt;|L&lt;sub&gt;r&lt;/sub&gt;-L&lt;sub&gt;s&lt;/sub&gt;|&lt;/i&gt;, last_service&lt;sub style=&quot;&quot;&gt;r&lt;/sub&gt;)&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
