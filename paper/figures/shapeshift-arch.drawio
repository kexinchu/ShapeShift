        <mxCell id="kS1Jh0xNyDCQ81UR72km-272" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;If &lt;i style=&quot;&quot;&gt;O&lt;/i&gt; is not empty,&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;choose oldest overdue&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;request in &lt;i&gt;O&lt;/i&gt;;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;else choose shortest&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;request in &lt;i&gt;R&lt;/i&gt;;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;initialize &lt;i style=&quot;&quot;&gt;B&lt;sub&gt;t&lt;/sub&gt;={s}&lt;/i&gt;.&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
